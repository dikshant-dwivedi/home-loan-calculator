        {
          "name": "Loan - POST /loan/calculate-with-prepayments (Periodic Extra)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 2xx', function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "",
                  "pm.test('Response is JSON', function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "pm.test('Response has expected structure', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success');",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Data has prepayment comparison properties', function () {",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data).to.have.property('original');",
                  "    pm.expect(data).to.have.property('modified');",
                  "    pm.expect(data).to.have.property('comparison');",
                  "    pm.expect(data).to.have.property('prepaymentSummary');",
                  "    pm.expect(data).to.have.property('modifiedSchedule');",
                  "    pm.expect(data.comparison).to.have.property('interestSaved');",
                  "    pm.expect(data.comparison).to.have.property('tenureReduced');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
