            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/loan/calculate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "loan", "calculate"]
            },
            "description": "Calculate EMI with minimal required fields (no startDate)."
          },
          "response": []
