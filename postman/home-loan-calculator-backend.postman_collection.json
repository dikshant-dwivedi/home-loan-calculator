            "body": {
              "mode": "raw",
              "raw": "{\n  \"loanParameters\": {\n    \"principal\": 5000000,\n    \"annualInterestRate\": 8.5,\n    \"tenureMonths\": 240,\n    \"startDate\": \"2024-01-01\"\n  },\n  \"prepayments\": [\n    {\n      \"type\": \"periodic_extra\",\n      \"startMonth\": 1,\n      \"endMonth\": 60,\n      \"extraAmountPerMonth\": 10000,\n      \"impactStrategy\": \"reduce_tenure\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/loan/calculate-with-prepayments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "loan", "calculate-with-prepayments"]
            },
            "description": "Calculate loan with periodic extra payments.\n\n**Prepayment Types:**\n- `periodic_extra`: Regular extra payments over a period\n- `lumpsum`: One-time large payment\n- `missed_payment`: Missed EMI payment\n\n**Impact Strategies:**\n- `reduce_tenure`: Keep EMI same, reduce loan duration\n- `reduce_emi`: Keep tenure same, reduce EMI amount"
          },
          "response": []
        },
