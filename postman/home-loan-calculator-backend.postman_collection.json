    {
      "name": "Loan",
      "item": [
        {
          "name": "Loan - POST /loan/calculate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 2xx', function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "",
                  "pm.test('Response is JSON', function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "pm.test('Response has expected structure', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success');",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "    pm.expect(jsonData).to.have.property('timestamp');",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Data has loan calculation properties', function () {",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data).to.have.property('loanParameters');",
                  "    pm.expect(data).to.have.property('calculation');",
                  "    pm.expect(data).to.have.property('amortizationSchedule');",
                  "    pm.expect(data.calculation).to.have.property('emi');",
                  "    pm.expect(data.calculation).to.have.property('totalInterest');",
                  "    pm.expect(data.calculation).to.have.property('totalAmount');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"principal\": 5000000,\n  \"annualInterestRate\": 8.5,\n  \"tenureMonths\": 240,\n  \"startDate\": \"2024-01-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/loan/calculate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "loan", "calculate"]
            },
            "description": "Calculate basic EMI and generate amortization schedule.\n\n**Request Body:**\n- `principal` (required): Loan amount in INR (₹1,00,000 - ₹10,00,00,000)\n- `annualInterestRate` (required): Annual interest rate percentage (0.01% - 30%)\n- `tenureMonths` (required): Loan tenure in months (6 - 480)\n- `startDate` (optional): ISO 8601 date string for loan start date"
          },
          "response": []
        },
        {
          "name": "Loan - POST /loan/calculate (Minimal)",
          "event": [
            {
              "listen": "test",
              "script": {
